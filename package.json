{
  "name": "imgviewer",
  "productName": "ImgViewer",
  "version": "1.0.0",
  "description": "A simple, fast, modern image viewer.",
  "main": "src/main/main.js",
  "author": "ppcharcoal",
  "license": "MIT",
  "homepage": "https://github.com/ppcharcoal/ImgViewer",
  "scripts": {
    "start": "electron .",
    "icon": "python3 scripts/make-icon.py",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:dir": "electron-builder --dir --publish never"
  },
  "dependencies": {
    "@jsquash/jxl": "^1.3.0",
    "heic-decode": "^2.1.0",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.ppcharcoal.imgviewer",
    "productName": "ImgViewer",
    "copyright": "Copyright © 2026 ppcharcoal",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "ImgViewer"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ImgViewer",
      "include": "build/installer.nsh",
      "artifactName": "ImgViewer-Setup-${version}.exe",
      "uninstallDisplayName": "ImgViewer"
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png"
    }
  }
}
